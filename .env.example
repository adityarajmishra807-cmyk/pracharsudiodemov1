# Server-side Gemini configuration
# Never expose GEMINI_API_KEY through a client/public environment variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Meta WhatsApp Embedded Signup
# META_APP_ID and META_CONFIG_ID are safe to expose to the client-side signup launcher.
# META_APP_SECRET must remain server-side only.
META_APP_ID=
META_CONFIG_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
