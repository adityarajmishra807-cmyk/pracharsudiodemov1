# Server-side Gemini configuration
# Never expose GEMINI_API_KEY through a client/public environment variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Meta WhatsApp Embedded Signup configuration (not used by Sessions QR flow)
VITE_META_APP_ID=
VITE_META_CONFIG_ID=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# Evolution API — backend used by the Sessions feature.
# Keep both values server-side; never prefix them with VITE_.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
