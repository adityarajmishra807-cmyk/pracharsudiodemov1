# Server-side Gemini configuration
# Never expose GEMINI_API_KEY through a client/public environment variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Meta WhatsApp Embedded Signup
# VITE_* values are public client configuration. META_APP_ID is duplicated server-side for code exchange.
VITE_META_APP_ID=
VITE_META_CONFIG_ID=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
