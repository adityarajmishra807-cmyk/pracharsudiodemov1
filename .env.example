# ---------------------------------------------------------------------------
# Prachar Studio server security
# ---------------------------------------------------------------------------

# Owner login. These are server-only values and must NEVER use the VITE_ prefix.
PRACHAR_OWNER_EMAIL=owner@example.com
PRACHAR_OWNER_PASSWORD=replace-with-a-long-random-password
PRACHAR_SESSION_SECRET=replace-with-at-least-32-random-characters

# Supabase. Keep the secret key server-side only.
# Prefer the new sb_secret_* key. The legacy service_role key is supported as a fallback.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_secret
SUPABASE_SERVICE_ROLE_KEY=

# Existing WhatsApp backend URL.
VITE_WHATSAPP_API_URL=http://localhost:3000

# Existing server-side Gemini configuration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Meta WhatsApp Embedded Signup configuration.
VITE_META_APP_ID=
VITE_META_CONFIG_ID=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
