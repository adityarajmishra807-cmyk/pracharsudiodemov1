# Frontend WhatsApp backend URL.
# This is the URL of visheshGupta01/evolution-whatsapp-manager,
# NOT the Evolution API URL itself.
# Example for local development: http://localhost:3000
VITE_WHATSAPP_API_URL=http://localhost:3000

# Server-side Gemini configuration
# Never expose GEMINI_API_KEY through a client/public environment variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Meta WhatsApp Embedded Signup configuration (not used by the backend sessions flow)
VITE_META_APP_ID=
VITE_META_CONFIG_ID=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
