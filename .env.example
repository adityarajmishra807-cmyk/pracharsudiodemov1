# Server-side Gemini configuration
# Never expose GEMINI_API_KEY through a client/public environment variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Meta WhatsApp Embedded Signup (not used by the QR flow)
VITE_META_APP_ID=
VITE_META_CONFIG_ID=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# Evolution API — used by the Sessions feature.
# Keep the API key server-side; never prefix these with VITE_.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=

# Existing WhatsApp gateway/BFF used by the Inbox implementation.
WHATSAPP_BACKEND_URL=
WHATSAPP_BACKEND_API_KEY=
