NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Evolution API v2
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me
EVOLUTION_TIMEOUT_MS=15000

# Backend safety limits
BODY_LIMIT=16mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Campaign safety
CAMPAIGN_MIN_DELAY_MS=1500
CAMPAIGN_MAX_ACTIVE=1
CAMPAIGN_DAILY_RECIPIENT_LIMIT=1000
CAMPAIGN_CREATE_WINDOW_MINUTES=10
CAMPAIGN_CREATE_LIMIT=10
CAMPAIGN_AUTO_PAUSE_MIN_RESULTS=20
CAMPAIGN_AUTO_PAUSE_FAILURE_RATE=0.35

# Supabase persistence
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of this manager's Evolution delivery webhook
EVOLUTION_WEBHOOK_URL=https://your-domain.com/api/webhooks/evolution
WEBHOOK_SECRET=change-this-to-a-long-random-secret
